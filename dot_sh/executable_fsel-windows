#!/usr/bin/env bash
# Switches focus to a niri window chosen with fsel.

set -euo pipefail

if [[ -z ${NIRI_SOCKET:-} ]]; then
    shopt -s nullglob
    sockets=("${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/niri.*.sock)
    shopt -u nullglob
    for sock in "${sockets[@]}"; do
        if NIRI_SOCKET="$sock" niri msg version >/dev/null 2>&1; then
            export NIRI_SOCKET="$sock"
            break
        fi
    done
fi

apps=$(fsel --stdout 2>/dev/null || echo '[]')
workspaces=$(niri msg -j workspaces)

choice=$(
    niri msg -j windows \
        | jq -r --argjson apps "$apps" --argjson workspaces "$workspaces" -f "$HOME/.sh/fsel-windows.jq" \
        | fsel --dmenu --only-match --delimiter=$'\t' --with-nth=2 --match-nth=2 --accept-nth=1
) || exit 0

[[ -n $choice ]] || exit 0
niri msg action focus-window --id "$choice"
