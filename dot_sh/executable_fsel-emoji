#!/usr/bin/env bash
# Picks an emoji with fsel, previews it in a side panel, remembers recent picks, and pastes it.

set -euo pipefail

if [[ ${1:-} == --preview ]]; then
    emoji=${2%%$'\t'*}
    [[ -n $emoji ]] || exit 0
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/fsel-emoji"
    mkdir -p "$cache_dir"
    png="$cache_dir/$(printf '%s' "$emoji" | cksum | cut -d' ' -f1).png"
    if [[ ! -f $png ]]; then
        pango-view -q --no-display --background=transparent --font="Noto Color Emoji 128" --text="$emoji" --output="$png"
    fi
    exec cat "$png"
fi

emoji_file="/usr/share/rofi-emoji/all_emojis.txt"
if [[ ! -r $emoji_file ]]; then
    echo "Emoji list not found: $emoji_file" >&2
    exit 1
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/fsel-emoji"
recent_file="$state_dir/recent"

selection=$(
    {
        if [[ -r $recent_file ]]; then
            cat "$recent_file"
        fi
        cat "$emoji_file"
    } \
        | awk -F'\t' '!seen[$1]++' \
        | FSEL_DMENU_TITLE_PANEL_HEIGHT_PERCENT=0 \
          fsel --dmenu --only-match --delimiter=$'\t' --with-nth=1,4 --match-nth=1,4,5 \
          --panel "Emoji:right:35:$0 --preview {}"
) || exit 0

[[ -n $selection ]] || exit 0
emoji=${selection%%$'\t'*}

mkdir -p "$state_dir"
tmp_file=$(mktemp "$state_dir/recent.XXXXXX")
{
    printf '%s\n' "$selection"
    if [[ -r $recent_file ]]; then
        cat "$recent_file"
    fi
} | awk -F'\t' '!seen[$1]++ && ++count <= 100' >"$tmp_file"
mv "$tmp_file" "$recent_file"

printf '%s' "$emoji" | wl-copy
printf '%s' "$emoji" | wl-copy --primary
setsid -f sh -c 'sleep 0.2; exec wtype -M shift -k Insert -m shift' </dev/null >/dev/null 2>&1
