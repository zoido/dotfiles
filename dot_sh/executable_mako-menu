#!/usr/bin/env bash
set -euo pipefail

choice=$(
    {
        echo "all: Dismiss all"
        makoctl list -j | jq -r '.[] | "\(.id): \(.app_name) - \(.summary)"'
    } | fsel --dmenu --only-match
) || exit 0
[[ -n $choice ]] || exit 0

id=${choice%%: *}
if [[ $id == all ]]; then
    makoctl dismiss --all
    exit 0
fi

action=$(
    {
        makoctl list -j | jq -r --argjson id "$id" '.[] | select(.id == $id) | .actions // {} | to_entries[] | "\(.key): \(.value)"'
        echo "dismiss: Dismiss"
    } | fsel --dmenu --only-match
) || exit 0
[[ -n $action ]] || exit 0

key=${action%%: *}
if [[ $key == dismiss ]]; then
    makoctl dismiss -n "$id"
else
    makoctl invoke -n "$id" "$key"
fi
