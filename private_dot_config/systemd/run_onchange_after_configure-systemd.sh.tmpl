#!/bin/bash
set -euo pipefail

systemctl --user daemon-reload

systemctl --user enable app-com.mitchellh.ghostty.service --now
systemctl --user enable llama-server.service --now
systemctl --user enable oo7-daemon.service --now
systemctl --user enable pipewire-pulse.socket --now
systemctl --user enable pipewire.socket --now
systemctl --user enable wireplumber.service --now

systemctl --user enable podman.socket

systemctl --user add-wants niri.service 1password.service
systemctl --user add-wants niri.service espanso.service
systemctl --user add-wants niri.service handy.service
systemctl --user add-wants niri.service kanshi.service
systemctl --user add-wants niri.service mako.service
systemctl --user add-wants niri.service soteria.service
systemctl --user add-wants niri.service swaybg.service
systemctl --user add-wants niri.service swayidle.service
systemctl --user add-wants niri.service swayosd.service
systemctl --user add-wants niri.service udiskie.service
systemctl --user add-wants niri.service vicinae.service

{{- if .laptop }}
systemctl --user add-wants niri.service batsignal.service
{{- end }}
