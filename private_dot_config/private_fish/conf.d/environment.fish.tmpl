# Pager settings
set -gx LESS '-M -i -R'
set -gx LESSCHARSET utf-8
set -gx LESSHISTSIZE 1000
set -gx PAGER less
set -gx EDITOR hx
set -gx MANPAGER $PAGER
set -gx DELTA_PAGER less
set -gx PISTOL_CHROMA_STYLE catppuccin-{{ .catppuccin.flavor }}
set -gx RIPGREP_CONFIG_PATH ~/.config/ripgrep/ripgreprc
{{- if .wsl }}
set -gx BROWSER wsl-open

# Reduce WSL interop appended paths. Only add the ones needed.
set -l wsl_path_allow '/System32/?$' '/WindowsApps/?$' '/WinGet/Links/?$'
set -l wsl_path_pattern (string join '|' $wsl_path_allow)
set -l wsl_pruned_path
for dir in $PATH
    if string match -qr '^/mnt/' -- $dir
        string match -qri -- $wsl_path_pattern $dir; or continue
    end
    set -a wsl_pruned_path $dir
end
set -gx PATH $wsl_pruned_path
{{- end }}

{{- if .termux }}
set -gx LD_PRELOAD /data/data/com.termux/files/usr/lib/libtermux-exec.so
{{- end }}

if command -q ov
    set -gx PAGER ov
    set -gx MANPAGER $PAGER
end

# PATH
fish_add_path --path "$HOME/go/bin"
fish_add_path --path "$HOME/bin"
fish_add_path --path "$HOME/.local/bin"
fish_add_path --path --append /sbin
fish_add_path --path --append "$HOME/.krew/bin"

# Locale
set -gx LANG en_US.UTF-8
