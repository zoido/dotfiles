font-size = 16
font-family = "JetBrainsMono NF"

theme = "Catppuccin Macchiato"
window-decoration = none
background-opacity = 0.85

# Minimal size where I can move helic cursor to char 80 without scroll.
window-width = 92
window-height = 30

quit-after-last-window-closed = false
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

shell-integration = detect
shell-integration-features = sudo,cursor,ssh-env,ssh-terminfo

quick-terminal-position = center
quick-terminal-size = 50%,50%
gtk-quick-terminal-namespace = ghostty-quick-terminal
