# Settings for restic on this machine.
#
# 95-restic.sh copies this file to /etc/restic/restic.env one time and does not
# change it after that. Edit the copy in /etc/restic.
#
# The file is a dotenv file for "op run" and a bash file for restic-job. Keep
# one KEY=value per line, and put values with spaces in double quotes.
#
# A value that starts with op:// is a 1Password secret reference. "op run"
# replaces it with the secret before restic starts. The format is
# op://<vault>/<item>/<field>. The service account must have read access to
# the vault.

# The repository for this machine. Each machine must use a different path.
#
# The bucket must use the Standard storage class or Autoclass. Nearline,
# Coldline, and Archive charge a fee when you read data or delete it early,
# and the forget and check jobs do both.
#
# Soft delete keeps deleted objects for 7 days by default. You pay for that
# storage after each prune, but you can restore files that something deleted.
RESTIC_REPOSITORY="gs:<bucket>:/<path>"

# The password of the restic repository.
RESTIC_PASSWORD="op://<vault>/<item>/password"

# The JSON key of the Google Cloud service account. The reference can point to
# a field or to a file attachment of the item. Give the service account the
# roles/storage.objectAdmin role on the bucket only.
GCS_KEY_JSON="op://<vault>/<item>/<key-file.json>"

# The Google Cloud project. restic needs it only if "restic init" must create
# the bucket.
#GOOGLE_PROJECT_ID="<project>"

# The snapshots that the daily forget job keeps.
RESTIC_KEEP="--keep-hourly 24 --keep-daily 7 --keep-weekly 4 --keep-monthly 3"

# The part of the data that the weekly check job downloads and reads. The value
# is a percentage or a size, for example 5% or 2G.
RESTIC_CHECK_SUBSET="5%"
