{
  "theme": "catppuccin-macchiato",
  "packages": [
    "git:github.com/otahontas/pi-coding-agent-catppuccin",
    "git:github.com/huggingface/pi-llama",
    "npm:@pi-lab/input-history@1.0.5",
    "npm:@clapecho233/pi-smart-fold@0.2.3"
  ],
  "lastChangelogVersion": "1.4.0",
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true,
    "trueColor": true
  },
  "enableInstallTelemetry": false,
  "enabledModels": [
    "github-copilot/claude-haiku-5.5",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5"
  ],
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-opus-5.5",
  "collapseChangelog": false,
  "defaultTools": [
    "+codemode"
  ],
  "tuiMode": "regular"
}
