#!/usr/bin/env bash
#
# gs-walkdown
#
# Runs a fish command on the current git-spice branch, then moves one branch
# down the stack with `gs down` and runs it again, until the next branch down
# is trunk or `gs down` fails. The command does not run on trunk.
# Stops at the first command failure, including a failure in any part of the
# last pipeline.
#
# Usage: gs-walkdown '<command>'
#
# Dependencies: fish, git-spice
#
set -euo pipefail

cmd=${1:?usage: gs-walkdown '<command>'}

readonly PIPEFAIL_CHECK='for s in $pipestatus; test $s -eq 0; or exit $s; end'

trunk=$(git-spice trunk -n)

while true; do
	fish -c "$cmd"$'\n'"$PIPEFAIL_CHECK"
	next=$(git-spice down -n 2>/dev/null) || break
	[[ $next == "$trunk" ]] && break
	git-spice down
done
